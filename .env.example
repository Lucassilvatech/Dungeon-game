# Local development only: change passwords before deployment.
POSTGRES_PASSWORD=tower
INITIAL_TREASURY=100000
MONSTER_REWARD=10
BOSS_REWARD=100
# Optional Discord profile: supply locally, never commit real values.
DISCORD_SERVICE_KEY=
DISCORD_TOKEN=

# Exploration tuning (provisional)
SECRET_CHANCE=0.25
SECRET_FIRST_REWARD=250
SECRET_REPEAT_REWARD=1

# First-floor combat and low-frequency wandering
DAMAGE_MIN=2
DAMAGE_MAX=999
SKILL_BONUS=5
GUARD_BONUS=4
WANDER_INTERVAL=4

# Provisional first-floor death/auction balance (not final game design)
MEDICAL_FEE_BASE=100
RESPAWN_HP_PERCENT=100
MIN_AUCTION_START_PRICE=1
AUCTION_DURATION_HOURS=24
AUCTION_PROCEEDS_DESTINATION=treasury
AUCTION_SWEEP_SECONDS=30

# Desenvolvimento LAN: 0.0.0.0 permite Android físico alcançar a porta web 8080.
# Mantenha 127.0.0.1 quando não precisar de acesso pela rede; use HTTPS no deploy.
FRONTEND_BIND=127.0.0.1
ADVENTURE_BOSS_INCREMENT=0.01
PROCEDURAL_PROXIMITY_K=3
PROCEDURAL_LEVEL_WEIGHT=0.65
